{
  "readonly_metashrew_db_dir": "/data/.metashrew/mainnet-v2.0.0/.metashrew-reconcile",
  "electrum_rpc_url": null,
  "metashrew_rpc_url": "http://127.0.0.1:7047",
  "electrs_esplora_url": "http://127.0.0.1:4332",
  "bitcoind_rpc_url": "http://127.0.0.1:8332",
  "bitcoind_rpc_user": "rpcuser",
  "bitcoind_rpc_pass": "rpcpass",
  "b8_faucet_url": null,
  "bitcoind_blocks_dir": "~/.bitcoin/blocks",
  "reset_mempool_on_startup": false,
  "rollback": null,
  "db_path": "./db",
  "sdb_poll_ms": 5000,
  "indexer_block_delay_ms": 0,
  "port": 8080,
  "explorer_host": "127.0.0.1:8081",
  "explorer_espo_rpc_host": null,
  "explorer_espo_rpc_key": null,
  "explorer_espo_rpc_cache_ms": 2000,
  "enable_internal_rpc": false,
  "internal_rpc_key": null,
  "explorer_base_path": "/",
  "google_analytics_tag": null,
  "sync_banner": null,
  "mempool": {
    "enabled": true,
    "populate_with_views": false,
    "raw_poll_secs": 60,
    "template_poll_secs": 10,
    "trace_workers": 1,
    "hydration_workers": 16,
    "clear_protection_secs": 180,
    "max_txs": 100000,
    "template_blocks": 8,
    "block_weight_units": 4000000,
    "regtest_block_interval_secs": 600,
    "zmq_rawtx_url": null,
    "zmq_sequence_url": null,
    "websocket_enabled": true,
    "websocket_path": "/api/events/ws"
  },
  "network": "mainnet",
  "metashrew_db_label": null,
  "strict_mode": {
    "check_utxos": false,
    "check_alkane_balances": false,
    "check_trace_mismatches": false
  },
  "jemalloc_profile": {
    "enabled": false,
    "dump_dir": "./jemalloc-profiles",
    "interval_secs": 1800,
    "dump_on_shutdown": true
  },
  "debug": false,
  "safe_tip_hook_script": null,
  "block_source_mode": "rpc",
  "trace_read_workers": 8,
  "debug_backup": null,
  "explorer_networks": {
    "mainnet": "https://explorer.example.com",
    "signet": "https://signet.example.com",
    "testnet3": "https://testnet.example.com",
    "testnet4": "https://testnet4.example.com",
    "regtest": "http://127.0.0.1:5081"
  },
  "modules": {
    "runes": {
      "enable": false,
      "load_live_outpoints": true
    }
  }
}
